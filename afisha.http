@host = http://localhost:5055

# Администратор: может создавать, менять, удалять и загружать постеры.
@adminLogin = admin
@adminPassword = admin

# Обычный пользователь: только смотрит афишу. Нужен для проверки 403.
@demoEmail = demo@afisha.local
@demoPassword = Demo12345

### 1. Список: страница 1, по 3 записи (доступен без входа)
GET {{host}}/api/events?page=1&pageSize=3
Accept: application/json

### 2. Фильтр по площадке (Клуб «Фонарь»)
GET {{host}}/api/events?venueId=2&page=1&pageSize=10

### 3. Только бесплатные
GET {{host}}/api/events?free=true

### 4. Фильтр по дате (UTC-день)
GET {{host}}/api/events?date=2027-02-14

### 5. Сортировка по цене (сначала дорогие)
GET {{host}}/api/events?sort=price&order=desc&pageSize=10

### 6. Сортировка по дате (сначала поздние)
GET {{host}}/api/events?sort=date&order=desc

### 7. Одна запись
GET {{host}}/api/events/1

### 8. Справочник площадок
GET {{host}}/api/venues

### 9. Регистрация обычного пользователя (201; повторный запуск вернёт 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "new.user@example.com",
  "displayName": "Новый пользователь",
  "password": "Passw0rd!"
}

### 10. Вход администратора (admin / admin)
# @name adminLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminLogin}}",
  "password": "{{adminPassword}}"
}

### 11. Текущий пользователь (в ответе role = Admin)
GET {{host}}/api/auth/me
Authorization: Bearer {{adminLogin.response.body.$.token}}

### 12. Вход обычного пользователя (для проверки 403)
# @name demoLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{demoEmail}}",
  "password": "{{demoPassword}}"
}

### 13. Создать мероприятие (201, только админ)
# @name createEvent
POST {{host}}/api/events
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Тестовое событие из .http",
  "description": "Создано администратором",
  "startsAt": "2027-08-01T15:00:00Z",
  "price": 50000,
  "seats": 40,
  "venueId": 2
}

### 14. Изменить мероприятие (200, только админ)
PUT {{host}}/api/events/{{createEvent.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Тестовое событие из .http (изменено)",
  "description": "Обновлено через PUT",
  "startsAt": "2027-08-02T15:00:00Z",
  "price": 60000,
  "seats": 45,
  "venueId": 2
}

### 15. Загрузить постер (200, только админ)
POST {{host}}/api/events/{{createEvent.response.body.$.id}}/poster
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample-poster.png"
Content-Type: image/png

< ./docs/sample-poster.png
--WebAppBoundary--

### 16. Удалить мероприятие (204, только админ)
DELETE {{host}}/api/events/{{createEvent.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### 17. 401 — создание без токена
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Без входа",
  "startsAt": "2027-09-01T12:00:00Z",
  "price": 0,
  "seats": 10,
  "venueId": 1
}

### 18. 403 — обычный пользователь пытается изменить запись
PUT {{host}}/api/events/1
Authorization: Bearer {{demoLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Обычный пользователь не может",
  "startsAt": "2027-02-14T13:00:00Z",
  "price": 1000,
  "seats": 10,
  "venueId": 1
}

### 19. 403 — обычный пользователь пытается создать запись
POST {{host}}/api/events
Authorization: Bearer {{demoLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Тоже нельзя",
  "startsAt": "2027-09-01T12:00:00Z",
  "price": 0,
  "seats": 10,
  "venueId": 1
}

### 20. 400 — ошибки валидации (пустое название, прошлое, цена -5, мест 0)
POST {{host}}/api/events
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "",
  "description": "Проверка ошибок",
  "startsAt": "2020-01-01T10:00:00Z",
  "price": -5,
  "seats": 0,
  "venueId": 999
}

### 21. 404 — несуществующая запись
GET {{host}}/api/events/99999

### 22. Правило 24 часов: создать событие на ближайшие 2 часа
# Дата берётся динамической переменной VS Code REST Client; при необходимости
# подставьте вручную, например 2026-11-06T03:00:00Z.
# @name nearEvent
POST {{host}}/api/events
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Событие менее чем за 24 часа",
  "description": "Нужно для проверки блокировки",
  "startsAt": "{{$datetime iso8601 2 h}}",
  "price": 0,
  "seats": 10,
  "venueId": 1
}

### 23. Правило 24 часов: изменить нельзя (400)
PUT {{host}}/api/events/{{nearEvent.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "title": "Попытка правки",
  "startsAt": "2027-12-01T12:00:00Z",
  "price": 0,
  "seats": 10,
  "venueId": 1
}

### 24. Правило 24 часов: удалить нельзя (400)
DELETE {{host}}/api/events/{{nearEvent.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### 25. Бронирование: занять 2 места (вошедший пользователь)
# @name reserve
POST {{host}}/api/events/2/reservations
Authorization: Bearer {{demoLogin.response.body.$.token}}
Content-Type: application/json

{
  "seats": 2
}

### 26. Мои брони
GET {{host}}/api/reservations/my
Authorization: Bearer {{demoLogin.response.body.$.token}}

### 27. Отменить свою бронь (204)
DELETE {{host}}/api/reservations/{{reserve.response.body.$.id}}
Authorization: Bearer {{demoLogin.response.body.$.token}}

### 28. 401 — бронь без входа
POST {{host}}/api/events/2/reservations
Content-Type: application/json

{
  "seats": 1
}

### 29. 400 — больше мест, чем осталось
POST {{host}}/api/events/2/reservations
Authorization: Bearer {{demoLogin.response.body.$.token}}
Content-Type: application/json

{
  "seats": 50
}
